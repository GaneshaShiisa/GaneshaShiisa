---
// src/components/CraftCard.astro
interface Props {
  title: string;
  description: string;
  image: string;
  date: string;
}

const { title, description, image, date } = Astro.props;
---

<div
  class="group relative rounded-xl border border-neutral-800 bg-neutral-900/50 p-4 transition-all duration-300 hover:border-neutral-700 hover:bg-neutral-900 hover:shadow-2xl"
>
  <!-- サムネイル画像エリア -->
  <div
    class="relative aspect-video w-full overflow-hidden rounded-lg bg-neutral-950"
  >
    <img
      src={image}
      alt={title}
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
  </div>

  <!-- テキスト情報エリア -->
  <div class="mt-4 flex items-center justify-between">
    <h3 class="font-medium text-neutral-200 group-hover:text-white">
      {title}
    </h3>
    <span class="text-xs text-neutral-500">{date}</span>
  </div>
  <p class="mt-1 text-sm text-neutral-400">{description}</p>
</div>
