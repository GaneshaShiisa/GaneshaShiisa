---
// src/pages/index.astro
import CraftCard from "../components/CraftCard.astro";
import "../styles/global.css";
import type { Craft } from "../types";

// 仮の作品データ（後で自由に変更・追加可能）
const projects: Craft[] = [
  {
    title: "Lumina Trace",
    description:
      "3D空間内を浮游する光体コア（彗星）をコントロールし、空間に残る美しい光のリボン（Trail）や宇宙塵（Dust Particles）、拡散する衝撃波（Burst Particles）などのインタラクティブな描画表現を楽しむ作品です。",
    date: "2026",
    link: "https://ganeshashiisa.github.io/lumina-trace/",
    sourceUrl: "https://github.com/ganeshashiisa/lumina-trace",
    video: "images/lumina-trace.webm",
  },
  {
    title: "Custom Auto Scroller",
    description:
      "速度調整パネル付きの自動スクロールを行う Google Chrome 拡張機能です。 閲覧中のWebページを好みの速度で自動スクロールさせることができ、ハンズフリーでのブラウジングをサポートします。",
    date: "2026",
    link: "https://github.com/GaneshaShiisa/auto-scroller",
    sourceUrl: "https://github.com/GaneshaShiisa/auto-scroller",
    video: "images/custom-auto-scroller.webm",
  },
  {
    title: "Electron As Wallpaper",
    description:
      "Electron の BrowserWindow を Windows デスクトップの壁紙（アイコンの背面）として配置・アタッチするためのライブラリ（ネイティブアドオン）です。",
    date: "2026",
    link: "https://github.com/GaneshaShiisa/electron-as-wallpaper",
    sourceUrl: "https://github.com/GaneshaShiisa/electron-as-wallpaper",
    video: "images/electron-as-wallpaper.webm",
  },
  {
    title: "Tiny Life Screen",
    description:
      "セル（生/死）のグリッド上で、周囲8セルの状態に基づき次の世代の状態が決定されるシミュレーションゲームです。32×6セル程度の空間で生命の動きをアニメーション表示します。",
    date: "2025",
    link: "https://github.com/GaneshaShiisa/TinyLifeScreen",
    sourceUrl: "https://github.com/GaneshaShiisa/TinyLifeScreen",
    video: "images/tiny-life-screen.webm",
  },
  {
    title: "Pomodoro Timer",
    description:
      "ポモドーロテクニック用のタイマーアプリケーションです。 25分と5分のタイマーが用意されています。",
    date: "2022",
    link: "https://github.com/GaneshaShiisa/Pomodoro_Timer",
    sourceUrl: "https://github.com/GaneshaShiisa/Pomodoro_Timer",
    video: "images/pomodoro-timer.webm",
  },
];
---

<html lang="ja" class="dark">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <title>Works by Ganesha</title>
  </head>
  <body
    class="bg-neutral-950 text-neutral-100 min-h-screen selection:bg-neutral-800"
  >
    <main class="max-w-5xl mx-auto px-6 py-20">
      <!-- ヘッダー部分（Rauno式） -->
      <header class="mb-12">
        <h1 class="text-xl font-medium tracking-tight text-white">
          Works by Ganesha
        </h1>
        <p class="text-sm text-neutral-400 mt-1">
          Personal projects, prototypes, and experiments.
        </p>
      </header>

      <!-- グリッドレイアウト（PCで2〜3列、スマホで1列） -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {
          projects.map((project) => (
            <CraftCard
              title={project.title}
              description={project.description}
              image={project.image ?? "/images/default-thumbnail.webp"}
              date={project.date}
              link={project.link}
              sourceUrl={project.sourceUrl}
              video={project.video}
            />
          ))
        }
      </div>
    </main>
  </body>
</html>
