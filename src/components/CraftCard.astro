---
// src/components/CraftCard.astro
import type { Craft } from "../types";

interface Props extends Craft {}

const { title, description, date, link, sourceUrl, image, video } = Astro.props;
---

<div
  class="group relative rounded-xl border border-neutral-800 bg-neutral-900/50 p-4 transition-all duration-300 hover:border-neutral-700 hover:bg-neutral-900 hover:shadow-2xl flex flex-col justify-between"
>
  <div>
    <!-- サムネイル画像エリア -->
    <a
      href={link}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`${title} を開く`}
      class="block relative aspect-video w-full overflow-hidden rounded-lg bg-neutral-950"
    >
      {
        video ? (
          <video
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            poster={image}
            aria-label={`${title} の動作イメージ`}
            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
          >
            <source src={video} type="video/mp4" />
          </video>
        ) : (
          <img
            src={image}
            alt={title}
            loading="lazy"
            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
        )
      }
    </a>

    <!-- テキスト情報エリア -->
    <div class="mt-4 flex items-center justify-between">
      <h3 class="font-medium text-neutral-200 group-hover:text-white">
        <a
          href={link}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:underline"
        >
          {title}
        </a>
      </h3>
      <span class="text-xs text-neutral-500">{date}</span>
    </div>
    <p class="mt-1 text-sm text-neutral-400">{description}</p>
  </div>

  <!-- リンクボタン配置エリア -->
  <div class="mt-6 flex items-center gap-4 text-xs">
    {
      sourceUrl && (
        <a
          href={sourceUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-neutral-400 transition-colors hover:text-neutral-200"
        >
          <span>Source / Details</span>
          <span>↗</span>
        </a>
      )
    }
  </div>
</div>
